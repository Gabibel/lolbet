# --- Discord ---------------------------------------------------------------
# https://discord.com/developers/applications -> Bot -> Reset Token
LOLBET_DISCORD_TOKEN=your-discord-bot-token

# --- Riot ------------------------------------------------------------------
# Dev key (regenerate every 24h): https://developer.riotgames.com/
# Personal key (free, permanent, apply once): https://developer.riotgames.com/app-type
LOLBET_RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default platform used by /register when no region is given.
# euw1 eun1 na1 kr jp1 br1 la1 la2 oc1 tr1 ru me1 sg2 tw2 vn2
LOLBET_DEFAULT_PLATFORM=euw1

# --- Storage ---------------------------------------------------------------
# SQLite on local disk. Never point this at a managed/paid database.
LOLBET_DATABASE_URL=sqlite+aiosqlite:///./data/lolbet.db

# --- Polling / rate limits -------------------------------------------------
LOLBET_POLL_INTERVAL_SECONDS=60
# Dev key: 20 / 100. Personal key: raise these to whatever Riot granted you.
LOLBET_RATE_LIMIT_PER_SECOND=20
LOLBET_RATE_LIMIT_PER_TWO_MINUTES=100
LOLBET_MAX_CONCURRENT_REQUESTS=5

# --- Betting ---------------------------------------------------------------
LOLBET_STARTING_BALANCE=1000
LOLBET_DAILY_AMOUNT=100
LOLBET_BET_LOCK_SECONDS=300
LOLBET_MIN_BET=1
LOLBET_MAX_BET=100000
# Cote plancher garantie par la banque : sans elle, miser tous du meme
# cote ne rapporte rien (le parimutuel ne rend que la mise).
LOLBET_HOUSE_MIN_MULTIPLIER=1.2
# false = tout reste dans le salon (message de fermeture + recap en reponse a
# l'annonce). true = un fil est ouvert sous l'annonce et tout y est poste.
LOLBET_USE_THREADS=false
# Poster un message quand la fenetre de paris se ferme.
LOLBET_ANNOUNCE_LOCK=true

# --- Sauvegardes -----------------------------------------------------------
# Instantane quotidien de la base dans data/backups/, rotation sur N jours.
LOLBET_BACKUP_ENABLED=true
LOLBET_BACKUP_KEEP=7
LOLBET_BACKUP_INTERVAL_HOURS=24

# Prevenir dans le salon d'annonce quand la cle Riot est refusee.
LOLBET_ALERT_BAD_KEY=true
LOLBET_ALERT_COOLDOWN_HOURS=6

# --- Misc ------------------------------------------------------------------
LOLBET_LOG_LEVEL=INFO
LOLBET_LOG_JSON=false
# Sync slash commands instantly to this guild while developing (optional).
# LOLBET_DEV_GUILD_ID=123456789012345678
